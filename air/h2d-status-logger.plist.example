<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.h2d-status-logger</string>
  <key>ProgramArguments</key><array>
    <string>/path/to/python3</string>
    <string>/path/to/h2d-custom-dashboard/air/h2d_logger.py</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/h2d-custom-dashboard/air</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/path/to/h2d-custom-dashboard/air/logger.log</string>
  <key>StandardErrorPath</key><string>/path/to/h2d-custom-dashboard/air/logger.log</string>
</dict></plist>
